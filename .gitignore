.DS_Store
*.log

# Local secrets and machine state
.env
.env.*
!.env.example
.canva_tokens.json
secrets/
analytics/ig_token.txt
.wrangler/
.pytest_cache/
__pycache__/

# Merged social-media build workspace local-only files
social-media/.env
social-media/.canva_tokens.json
social-media/secrets/
social-media/analytics/ig_token.txt
social-media/.wrangler/
social-media/.pytest_cache/
social-media/**/__pycache__/
social-media/jma-graphic-studio/.env
social-media/jma-graphic-studio/node_modules/
social-media/jma-graphic-studio/dist/
social-media/jma-graphic-studio/.wrangler/

# Local render byproducts (duplicated into images/ on publish)
social-media/campaigns/outputs/

# Weekly generated graphics now live in Cloudflare R2, not git
images/week*/
# Featured-job graphics now live in Cloudflare R2, not git
images/featured/

# Quote-author source photos (copyrighted third-party images) stay local only.
social-media/assets/quote_authors/*.jpg
social-media/assets/quote_authors/*.jpeg
social-media/assets/quote_authors/*.png
social-media/assets/quote_authors/*.webp
social-media/assets/quote_authors/_cutout/

# Generated into .pages-dist at build time by scripts/pages-build.sh
deploy-check.txt

# Cloudflare Pages staging dir, rebuilt by scripts/pages-build.sh on every deploy
.pages-dist/
